# Local DB (compose PostgreSQL), cloud SEPEX + S3.
# Copy to .env before running `just up-hybrid`.

# Pipeline database (local compose)
POSTGRES_USER=twodfim
POSTGRES_PASSWORD=twodfim
POSTGRES_DB=twodfim
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# S3 (real AWS, not MinIO)
# The keys can be left out where AWS credentials already come from elsewhere
# (AWS_PROFILE, or a role attached to the machine).
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_SESSION_TOKEN=<aws-session-token>
AWS_REGION=us-east-1
# AWS_REQUEST_PAYER=requester
# Where everything the system writes lives; a new value is a new, empty area.
TWOD_FIM_DATA_ROOT_PREFIX=s3://<artifacts-bucket-name>/version=2026.09
# What {source_data} in an AOI config stands for; source data is only read.
TWOD_FIM_SOURCE_DATA_PREFIX=s3://<artifacts-bucket-name>/source_data

# Cloud SEPEX, at whatever address this machine reaches it: its private IP from
# inside the VPC, or a local port forwarded to it through SSM.
SEPEX_URL=http://<cloud-sepex-address>

# Cloud Batch runs on GPU instances
GPU_AVAILABLE=true
