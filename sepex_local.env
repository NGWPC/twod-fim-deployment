# ==============================================
#                    API Settings
# ==============================================

# --- Core
REPO_URL='https://github.com/Dewberry/sepex' # Repository URL for links and context.
API_NAME='sepex-local-twodfim'                            # The API will launch all jobs on cloud with this name prefix.
API_PORT='5050'                             # Default port for the API (Optional).

# --- File & Logging
LOG_LEVEL='DEBUG'                           # Log verbosity level (Optional).
LOG_FILE='/.data/logs/api.jsonl'            # Location for the main API logs (Optional).
TMP_JOB_LOGS_DIR='/.data/tmp/job_logs'      # Directory for temporary job logs.

# --- Database
DB_SERVICE='sqlite'                         # Options: ['sqlite', 'postgres']

# Policies
EXPIRY_DAYS='7'                             # Duration after which certain data might expire.

# --- Storage
STORAGE_SERVICE='minio'                     # Options: ['minio', 'aws-s3']
STORAGE_BUCKET='sepex-storage'
STORAGE_METADATA_PREFIX='metadata'
STORAGE_RESULTS_PREFIX='results'
STORAGE_LOGS_PREFIX='logs'

# --- Auth
AUTH_SERVICE=''                             # Options: ['', 'keycloak'] (Optional).
AUTH_LEVEL='0'                              # Options: [0, 1, 2] corresponds to [no auth, some routes protected, all routes protected] (Optional).
AUTH_ADMIN_ROLE='admin'
AUTH_SERVICE_ROLE='service_account'

# --- Plugins
PLUGINS_LOAD_DIR='/plugins'                        # Load plugins from this directory at startup (Optional).
PLUGINS_DIR='/.data/plugins'

SEPEX_DOCKER_NETWORK='twodfim_net'

# ==============================================
#                 Providers Settings
# ==============================================

# --- SQLITE
SQLITE_DB_PATH='/.data/db.sqlite'           # Path to the database file for sqlite or Connection string for postgres.  # Log group for AWS Batch.

# --- MinIO (Option for storage and development use)
MINIO_ACCESS_KEY_ID=minio
MINIO_SECRET_ACCESS_KEY=minio123
MINIO_S3_ENDPOINT=http://minio:9000
MINIO_S3_REGION=us-east-1
MINIO_ROOT_USER=user
MINIO_ROOT_PASSWORD=password


# ==============================================
#          Process Specific Settings
# ==============================================
# (Add settings specific to local (docker & subprocess) processes here. For example env variables need to be passed to processes.)
# Each container process specific env variable must start with capitalized name of process and _ for example for process `pywrite`
# the env variable should be `PYWRITE_MINIO_AWS_ACCESS_KEY`, this is case sensitive.
# they would be passed to the container with prefix PYWRITE_ removed

# Every artifact read and write in these jobs goes through fsspec -> s3fs ->
# boto3, so they need the ordinary boto3 credential variables. Without them the
# job gets as far as signing its first request and dies with
# NoCredentialsError, which names nothing about the deployment.
#
# AWS_REQUEST_PAYER is deliberately absent. It is only needed to read a
# requester-pays SOURCE bucket -- the /vsis3 land-cover mosaic the images
# default to -- and this deployment overrides lulc_source to a local /data
# file. Sending it at MinIO, which does not implement request payment, risks
# failing the reads and writes that do matter. Same reasoning as
# recon/workers.py::job_env.

# --- buildModel
BUILDMODEL_AWS_ENDPOINT_URL=http://minio:9000
BUILDMODEL_AWS_ACCESS_KEY_ID=minio
BUILDMODEL_AWS_SECRET_ACCESS_KEY=minio123
BUILDMODEL_AWS_DEFAULT_REGION=us-east-1
BUILDMODEL_ARTIFACTS_S3_BUCKET=twod-fim-artifacts
BUILDMODEL_MAJOR_VERSION=1

# --- runNdScenariosLisfloodCpu / runNdScenariosLisfloodGpu
# The prefix is the plugin's info.id uppercased (sepex: ToUpper(processID)+"_"),
# so the two hardware variants each need their own copy of the same values.
RUNNDSCENARIOSLISFLOODCPU_AWS_ENDPOINT_URL=http://minio:9000
RUNNDSCENARIOSLISFLOODCPU_AWS_ACCESS_KEY_ID=minio
RUNNDSCENARIOSLISFLOODCPU_AWS_SECRET_ACCESS_KEY=minio123
RUNNDSCENARIOSLISFLOODCPU_AWS_DEFAULT_REGION=us-east-1

RUNNDSCENARIOSLISFLOODGPU_AWS_ENDPOINT_URL=http://minio:9000
RUNNDSCENARIOSLISFLOODGPU_AWS_ACCESS_KEY_ID=minio
RUNNDSCENARIOSLISFLOODGPU_AWS_SECRET_ACCESS_KEY=minio123
RUNNDSCENARIOSLISFLOODGPU_AWS_DEFAULT_REGION=us-east-1