# Pipeline database (twodfim)
POSTGRES_USER=twodfim
POSTGRES_PASSWORD=twodfim
POSTGRES_DB=twodfim
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Dagster metadata database
DAGSTER_PG_USER=twodfim
DAGSTER_PG_PASSWORD=twodfim
DAGSTER_PG_HOST=localhost
DAGSTER_PG_PORT=5432
DAGSTER_PG_DB=dagster
DAGSTER_HOME=/path/to/twod-fim-deployment/orchestrator

# S3
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
# Include AWS_SESSION_TOKEN if using temporary credentials (ASIA... keys from SSO/access portal)
#AWS_SESSION_TOKEN=
AWS_ENDPOINT_URL=http://localhost:9000
AWS_REQUEST_PAYER=requester
DAGSTER_S3_BUCKET=dagster-logs
ARTIFACTS_S3_BUCKET=twod-fim-artifacts
MAJOR_VERSION=1

# Set to linux/amd64 on macOS (Apple Silicon). Leave unset on Linux x86_64.
#DOCKER_PLATFORM=linux/amd64

# Local raster override (when USGS requester-pays access is unavailable).
# Mount a host directory into the worker container and override lulc_source.
#DOCKER_DATA_DIR=/path/to/local/rasters
#LULC_SOURCE=/data/Annual_NLCD_LndCov_2023_CU_C1V0.tif
