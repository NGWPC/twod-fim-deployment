# Pipeline database (twodfim)
POSTGRES_USER=twodfim
POSTGRES_PASSWORD=twodfim
POSTGRES_DB=twodfim
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# True on a host with an NVIDIA GPU and the NVIDIA Container Toolkit: the loop
# submits the GPU process variants, only those are registered, and `just up-local`
# starts SEPEX with the GPUs (profile local-gpu in docker-compose.yml).
# GPU_AVAILABLE=true

# Registers local docker process definitions with the ":local" image they name
# (build it or `docker tag` a pulled one, see reconciler/README.md) instead
# of the published GHCR image. Off by default: nothing to build or pull first.
# USE_LOCAL_IMAGES=true

# S3
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
# Include AWS_SESSION_TOKEN if using temporary credentials (ASIA... keys from SSO/access portal)
#AWS_SESSION_TOKEN=
AWS_ENDPOINT_URL=http://localhost:9000
AWS_REQUEST_PAYER=requester
# Where everything the system writes lives; a new value is a new, empty area.
TWOD_FIM_DATA_ROOT_PREFIX=s3://twod-fim-artifacts/version=2026.09
# What {source_data} in an AOI config stands for; source data is only read.
TWOD_FIM_SOURCE_DATA_PREFIX=s3://twod-fim-artifacts/source_data
SEPEX_STORAGE_BUCKET=sepex-storage

# Job container overrides (local dev only).
# Job containers run as siblings on the compose network, so they reach services
# at compose service names, not localhost. In cloud these fall back to
# POSTGRES_HOST and AWS_ENDPOINT_URL automatically.
POSTGRES_HOST_FOR_JOBS=db
AWS_ENDPOINT_URL_FOR_JOBS=http://minio:9000

# SEPEX URL (required - all jobs go through SEPEX)
SEPEX_URL=http://localhost:5050

# Set to linux/amd64 on macOS (Apple Silicon). Leave unset on Linux x86_64.
#DOCKER_PLATFORM=linux/amd64
