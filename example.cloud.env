# Pipeline database (twodfim)
POSTGRES_USER=twodfim_app
POSTGRES_PASSWORD=<choose-a-password>
POSTGRES_DB=twodfim
POSTGRES_PORT=5432
# terraform output -raw rds_address
POSTGRES_HOST=<rds-address>

# RDS master password (for deploy/setup.py)
# terraform output -raw rds_master_user_secret_arn
RDS_SECRET_ARN=<rds-master-user-secret-arn>

# Dagster metadata database
DAGSTER_PG_USER=dagster_app
DAGSTER_PG_PASSWORD=<choose-a-password>
# terraform output -raw rds_address
DAGSTER_PG_HOST=<rds-address>
DAGSTER_PG_PORT=5432
DAGSTER_PG_DB=dagster

# S3
AWS_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
AWS_REQUEST_PAYER=requester
# dagster_s3_bucket from terraform.tfvars
DAGSTER_S3_BUCKET=<dagster-bucket-name>
# prod_bucket_name or test_bucket_name from terraform.tfvars
ARTIFACTS_S3_BUCKET=<artifacts-bucket-name>
MAJOR_VERSION=1

# SEPEX runner (set to submit jobs through SEPEX instead of local Docker)
# SEPEX handles Docker and Batch execution on a separate EC2.
# When set, POSTGRES_HOST_FOR_JOBS and AWS_ENDPOINT_URL_FOR_JOBS fall back
# to POSTGRES_HOST and AWS_ENDPOINT_URL automatically.
SEPEX_URL=http://<sepex-private-ip>

# Docker container runner (used when SEPEX_URL is not set)
ORCHESTRATOR_IMAGE=ghcr.io/ngwpc/twod-fim-deployment/orchestrator:dev
BUILD_MODEL_IMAGE=ghcr.io/ngwpc/twod-fim-jobs/build_model:dev
DOCKER_NETWORK=host

# Local raster override (when requester-pays access is unavailable).
# Download the raster to EC2 and mount it into the build_model container.
#DOCKER_DATA_DIR=/opt/twod-fim-data/rasters
#LULC_SOURCE=/data/Annual_NLCD_LndCov_2023_CU_C1V0.tif
